{
  "name": "nex-store",
  "version": "2.5.0",
  "description": "NEX Store — Full-Stack Next-Gen Hardware Commerce Platform with SQLite 3 Persistence & Real-Time WebSockets",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "build": "vite build && rm -rf server/static && cp -r dist server/static",
    "start": "[ -d node_modules/express ] || npm install --omit=dev --no-audit --no-fund; node server/index.js",
    "dev": "vite build && node server/index.js",
    "test": "node server/verify.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devTechs001/nex-store.git"
  },
  "keywords": [
    "ecommerce",
    "sqlite",
    "websockets",
    "realtime",
    "react",
    "tailwindcss",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "vite": "^6.2.0"
  }
}
