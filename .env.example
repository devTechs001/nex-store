# © 2026 NEX STORE & DEVTECHS001 LABS — STRICTLY PROPRIETARY ENVIRONMENT CONFIGURATION
# Copy to .env for local or cloud deployment (Render / Netlify / Vercel / Fly.io)

# ============================================================================
# 1. ROOT ADMIN AUTHENTICATION CREDENTIALS (Strictly Loaded via process.env)
# ============================================================================
NEX_ADMIN_USERNAME=nex_root_admin
NEX_ADMIN_EMAIL=admin@nexstore.dev
NEX_ADMIN_PASSWORD=NEX-Root-Admin-2026!#
NEX_ADMIN_MASTER_TOKEN=nex_adm_live_99f8a7d6c5b4e3210fedcba987654321

# ============================================================================
# 2. RENDER CLOUD BACKEND ENVIRONMENT VARIABLES (Express + WebSocket + SQLite)
# Paste these into Render Dashboard -> Service -> Environment -> Add from .env
# ============================================================================
PORT=3000
HOST=0.0.0.0
NEX_NODE_ENV=production
RENDER=true
RENDER_SERVICE_NAME=nex-store-fullstack-api
RENDER_SERVICE_TYPE=web
RENDER_REGION=frankfurt
RENDER_INSTANCE_TYPE=standard
RENDER_EXTERNAL_URL=https://nex-store-api.onrender.com
NEX_SQLITE_DB_PATH=/home/user/nex-store/server/nex-store.sqlite
NEX_RENDER_SERVICE_ID=srv-nexstore-live-2026
NEX_RENDER_API_KEY=rnd_live_nexstore_98a7b6c5d4e3f210
NEX_RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-nexstore-live

# ============================================================================
# 3. NETLIFY EDGE FRONTEND & BUILD ENVIRONMENT VARIABLES (Vite + PWA + CDN)
# Paste these into Netlify Dashboard -> Site configuration -> Environment variables
# ============================================================================
NETLIFY=true
NODE_VERSION=22
NPM_FLAGS=--include=dev --no-audit --no-fund
NETLIFY_SITE_NAME=nex-store-global
URL=https://nex-store-global.netlify.app
DEPLOY_PRIME_URL=https://main--nex-store-global.netlify.app
VITE_NEX_APP_NAME=NEX Store Enterprise Hub
VITE_NEX_APP_ENV=production
VITE_API_BASE_URL=https://nex-store-api.onrender.com
VITE_WS_URL=wss://nex-store-api.onrender.com/ws
VITE_RENDER_BACKEND_URL=https://nex-store-api.onrender.com
NEX_NETLIFY_SITE_ID=site_nexstore_edge_2026
NEX_NETLIFY_AUTH_TOKEN=nfp_live_nexstore_edge_token_2026
NEX_NETLIFY_DEPLOY_HOOK=https://api.netlify.com/build_hooks/nex_cluster_live

# ============================================================================
# 4. MULTI-CLOUD CORS & REAL-TIME PAYMENT GATEWAY CONFIGURATION
# ============================================================================
CORS_ALLOWED_ORIGINS=https://nex-store-global.netlify.app,https://nex-store-api.onrender.com,http://localhost:3000
NEX_VERCEL_EDGE_HOOK=https://api.vercel.com/v1/integrations/deploy/nexstore
NEX_PAYMENT_GATEWAY_MODE=LIVE_SETTLEMENT
NEX_PAYMENT_WEBHOOK_SECRET=whsec_nex_pay_live_84729103847
